{
  "name": "survive-30-sols",
  "private": true,
  "version": "1.0.0",
  "description": "A turn-based outpost game where students keep a crew alive on the Moon or Mars for 30 sols, using real NASA numbers. NASA Space Apps 2026.",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "vite --host",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "simulate": "node scripts/simulate.mjs",
    "textures": "node scripts/build-textures.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satellite.js": "^7.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
